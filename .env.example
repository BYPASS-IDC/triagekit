# ── GitHub (required) ──────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── LLM provider (pick ONE block) ──────────────────────────────
# Any OpenAI-compatible API works (NIM, Ollama, OpenAI, LM Studio, etc.)

# --- Option 1: NVIDIA NIM ---
# Key: https://build.nvidia.com  →  API keys
# List models your key can use (PowerShell):
#   $h = @{ Authorization = "Bearer nvapi-YOUR_KEY" }
#   (Invoke-RestMethod -Uri "https://integrate.api.nvidia.com/v1/models" -Headers $h).data.id
# List models (bash/curl):
#   curl -s https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer nvapi-YOUR_KEY" | jq -r '.data[].id'
#
LLM_API_KEY=nvapi-...
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#
# Recommended instruct / coding models (from a live catalog snapshot):
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Alternatives (uncomment one):
# LLM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# LLM_MODEL=nvidia/llama-3.1-nemotron-51b-instruct
# LLM_MODEL=mistralai/mistral-large-2-instruct
# LLM_MODEL=mistralai/mistral-large
# LLM_MODEL=mistralai/mixtral-8x22b-v0.1
# LLM_MODEL=mistralai/mistral-7b-instruct-v0.3
# LLM_MODEL=z-ai/glm-5.3
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_MODEL=moonshotai/kimi-k2.6
# LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
# LLM_MODEL=deepseek-ai/deepseek-coder-6.7b-instruct
# LLM_MODEL=nv-mistralai/mistral-nemo-12b-instruct
# LLM_MODEL=microsoft/phi-3.5-moe-instruct
# LLM_MODEL=ibm/granite-3.0-8b-instruct
# LLM_MODEL=meta/codellama-70b
# LLM_MODEL=google/gemma-3-12b-it
# LLM_MODEL=minimaxai/minimax-m3.1-flash
# LLM_MODEL=stepfun-ai/step-5-preview
# LLM_MODEL=openai/gpt-oss-20b
#
# Avoid for TriageKit: vision-only, embed, rerank, safety-only, translate, OCR models.

# --- Option 2a: Ollama Cloud ---
# Create a key at https://ollama.com
# LLM_API_KEY=your_ollama_cloud_key
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=llama3.2
# (LLM_BASE_URL=https://ollama.com/api is also accepted)

# --- Option 2b: Ollama (local, free) ---
# Install: https://ollama.com
#   ollama pull llama3.2
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# --- Option 3: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# (OPENAI_* still works; LLM_* is preferred when set)

# ── Dashboard (optional) ───────────────────────────────────────
TRIAGEKIT_HOST=127.0.0.1
TRIAGEKIT_PORT=8000
